# Base de datos Postgres (Neon). En Vercel estas dos las completa sola la integración con Neon.
# En tu compu usá la rama "dev" de Neon (no la de producción, porque el seed borra todo).
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"   # en Vercel: https://tu-app.vercel.app
NEXTAUTH_SECRET="generá-uno-con: npx auth secret  o  openssl rand -base64 32"

# Email (link mágico). Si EMAIL_SERVER está vacío, el link se imprime en la consola del servidor.
# Con Gmail: smtps://TU_EMAIL%40gmail.com:CONTRASEÑA_DE_APLICACION@smtp.gmail.com:465
EMAIL_SERVER=""
EMAIL_FROM="Cancionero <tu_email@gmail.com>"

# Google OAuth (opcional: si están vacías, el botón de Google se oculta)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Login demo: solo en tu compu. En producción tiene que ser "false".
ENABLE_DEMO_LOGIN="true"

# Web Push — generá las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu_email@gmail.com"

# Zona horaria para mostrar fechas (opcional, por defecto Argentina)
APP_TIMEZONE="America/Argentina/Buenos_Aires"
