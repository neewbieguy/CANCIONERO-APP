# Base de datos (SQLite en local; para Postgres cambiá el provider en prisma/schema.prisma)
DATABASE_URL="file:./cancionero.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generá-uno-con: npx auth secret  o  openssl rand -base64 32"

# Google OAuth (opcional: si están vacías, el botón de Google se oculta)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (link mágico). Si EMAIL_SERVER está vacío, el link se imprime en la consola del servidor.
EMAIL_SERVER=""
EMAIL_FROM="Cancionero <no-reply@cancionero.app>"

# Login demo (solo en desarrollo, usa el usuario del seed)
ENABLE_DEMO_LOGIN="true"

# Web Push (etapa 5) — generá las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@cancionero.app"
