// Cancionero — esquema de datos
// Base de datos: Postgres (Neon). Los "enums" se modelan como String;
// los valores válidos viven en src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión con pooling (la usa la app)
  directUrl = env("DATABASE_URL_UNPOOLED") // conexión directa (la usan las migraciones)
}

// ---------- Auth (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  theme         String    @default("dark") // dark | light | system
  currentTeamId String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  participations    EventParticipant[]
  favorites         SongFavorite[]
  notifications     Notification[]
  invitesCreated    Invite[]
  pushSubscriptions PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Equipos ----------

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  events      Event[]
  songs       Song[]
  invites     Invite[]
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  teamId     String
  role       String   @default("member") // admin | member
  instrument String? // rol habitual: "Voz", "Bajo", "Sonido"...
  joinedAt   DateTime @default(now())

  // Permisos que el admin le da a un miembro (los admins los tienen todos)
  canManageEvents Boolean @default(false) // crear, editar y borrar eventos y setlists
  canManageSongs  Boolean @default(false) // añadir, editar y borrar canciones
  canInvite       Boolean @default(false) // ver y compartir el link de invitación

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  teamId      String
  createdById String
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ---------- Eventos y setlists ----------

model Event {
  id             String    @id @default(cuid())
  teamId         String
  title          String
  date           DateTime
  endDate        DateTime?
  template       String    @default("custom") // sunday_service | rehearsal | concert | custom
  location       String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  setlist      SetlistItem[]
  participants EventParticipant[]

  @@index([teamId, date])
}

model SetlistItem {
  id          String  @id @default(cuid())
  eventId     String
  type        String // song | moment
  order       Int
  songId      String? // si type = song
  title       String? // si type = moment ("Oración", "Ofrenda"...)
  key         String? // tono para este evento (puede diferir del original)
  durationMin Int?
  notes       String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song  Song? @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([eventId, order])
  @@index([songId])
}

model EventParticipant {
  id          String    @id @default(cuid())
  eventId     String
  userId      String
  role        String // "Voz principal", "Guitarra", "Sonido"...
  status      String    @default("pending") // pending | confirmed | declined
  respondedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// ---------- Canciones ----------

model Song {
  id         String   @id @default(cuid())
  teamId     String
  title      String
  artist     String?
  key        String? // "G", "Bb", "F#m"
  bpm        Int?
  chordSheet String? // texto ChordPro
  tags       String? // CSV simple
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  favorites    SongFavorite[]
  setlistItems SetlistItem[]

  @@index([teamId, title])
}

model SongFavorite {
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}

// ---------- Notificaciones ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // event_invite | event_updated | member_joined
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
